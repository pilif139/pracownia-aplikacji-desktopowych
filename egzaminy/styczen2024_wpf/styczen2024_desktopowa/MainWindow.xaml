<Window x:Class="styczen2024_desktopowa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wprowadzenie danych do paszportu. Wykonał: 123"
        Height="335" Width="741"
        Background="CadetBlue">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Numer" Grid.Row="0" Grid.Column="0" Foreground="White"/>
            <TextBox x:Name="txtNumer" Grid.Row="0" Grid.Column="1"
                     Background="Azure" Margin="5,5,5,5"
                     LostFocus="txtNumer_LostFocus"/>

            <Label Content="Imię" Grid.Row="1" Grid.Column="0" Foreground="White"/>
            <TextBox x:Name="txtImie" Grid.Row="1" Grid.Column="1"
                     Background="Azure" Margin="5,5,5,5"/>

            <Label Content="Nazwisko" Grid.Row="2" Grid.Column="0" Foreground="White"/>
            <TextBox x:Name="txtNazwisko" Grid.Row="2" Grid.Column="1"
                     Background="Azure" Margin="5,5,5,5"/>

            <GroupBox Header="Kolor oczu" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="5,5,5,5" Foreground="White">
                <StackPanel>
                    <RadioButton x:Name="rbNiebieskie" Content="niebieskie"
                                 GroupName="Oczy" IsChecked="True" Margin="10,5" Foreground="White"/>
                    <RadioButton x:Name="rbZielone" Content="zielone"
                                 GroupName="Oczy" Margin="10,5" Foreground="White"/>
                    <RadioButton x:Name="rbPiwne" Content="piwne"
                                 GroupName="Oczy" Margin="10,5" Foreground="White"/>
                </StackPanel>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Image x:Name="imgZdjecie" Height="180" Stretch="Uniform" Margin="20" Grid.Row="0" Grid.Column="0" Source="pack://application:,,,/materialy/000-zdjecie.jpg"/>
            <Image x:Name="imgOdcisk" Height="180" Stretch="Uniform" Margin="20" Grid.Row="0" Grid.Column="1" Source="pack://application:,,,/materialy/000-odcisk.jpg"/>

            <Button x:Name="btnOk" Content="OK" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Width="200"
                Background="Azure" Padding="10,4"
                Click="btnOk_Click"/>
        </Grid>
    </Grid>
</Window>